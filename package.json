{
  "name": "inabakumori-site",
  "version": "1.0.0",
  "description": "稲葉曇气象观测站粉丝网站",
  "main": "script.js",
  "scripts": {
    "frontend": "python3 -m http.server 5500 --bind 127.0.0.1",
    "backend": "cd backend && node server.mjs",
    "test": "node --test tools/tests/*.test.cjs",
    "build": "esbuild tools/auth-src.js --bundle --platform=browser --format=iife --minify-whitespace --legal-comments=inline --outfile=js/auth.js",
    "check": "npm test && npm run build",
    "check:links": "node tools/check-links.mjs",
    "check:links:strict": "node tools/check-links.mjs --strict"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "esbuild": "^0.28.2",
    "supertokens-web-js": "^0.16.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "browser-tabs-lock@1.3.0": true
  }
}
