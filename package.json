{
  "name": "inabakumori-site",
  "version": "1.0.0",
  "description": "稲葉曇气象观测站粉丝网站",
  "main": "script.js",
  "scripts": {
    "frontend": "node tools/static-server.mjs",
    "backend": "cd backend && node server.mjs",
    "test": "node --test tools/tests/*.test.cjs",
    "build": "node tools/build-site.mjs",
    "build:local": "node tools/build-site.mjs --keep-local-api-csp",
    "lint": "eslint script.js js tools backend eslint.config.mjs",
    "check": "npm run lint && npm run check:changelog:structure && npm test && npm --prefix backend run check && npm run build && node tools/check-build.mjs",
    "check:changelog": "node tools/check-changelog-table.mjs",
    "check:changelog:structure": "node tools/check-changelog-table.mjs --structure-only",
    "check:links": "node tools/check-links.mjs",
    "check:links:strict": "node tools/check-links.mjs --strict",
    "preview": "npm run build:local && node tools/static-server.mjs --dist",
    "test:integration": "node tools/integration.mjs",
    "optimize:images": "node tools/optimize-images.mjs",
    "generate:nknk": "node tools/generate-nknk-gallery.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "esbuild": "^0.28.2",
    "supertokens-web-js": "^0.16.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "browser-tabs-lock@1.3.0": true
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
