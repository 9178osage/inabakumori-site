NODE_ENV=production
HOST=0.0.0.0
API_DOMAIN=https://api.example.com
WEBSITE_URL=https://9178osage.github.io/inabakumori-site/
# Required in production. Use 1 on Railway (one proxy hop). Wrong values break rate limits.
TRUST_PROXY=1
COMMENTS_DB_PATH=/data/comments.db
SUPERTOKENS_CONNECTION_URI=https://your-supertokens-connection-uri
SUPERTOKENS_API_KEY=replace-with-your-api-key
ADMIN_USER_IDS=
# Only verified login-method emails grant admin access. This site does not currently
# enable email verification: use stable user IDs from your trusted SuperTokens dashboard.
ADMIN_EMAILS=
