NODE_ENV=production
HOST=0.0.0.0
API_DOMAIN=https://api.example.com
WEBSITE_URL=https://osagechan.top/
# Optional comma-separated extra browser origins (bare https origins, no paths), e.g. an old domain during a move.
ADDITIONAL_WEBSITE_ORIGINS=
# Required in production. Use 1 on Railway (one proxy hop). Wrong values break rate limits.
TRUST_PROXY=1
COMMENTS_DB_PATH=/data/comments.db
SUPERTOKENS_CONNECTION_URI=https://your-supertokens-connection-uri
SUPERTOKENS_API_KEY=replace-with-your-api-key
# Comma-separated SuperTokens user IDs with admin rights. This is the ONLY way to grant admin.
# Find an ID with a trusted lookup (SuperTokens core / your own logged-in sFrontToken "uid").
ADMIN_USER_IDS=
# Optional: enables GET /api/admin/backup (Authorization: Bearer <token>). Use >= 32 random chars,
# e.g. `openssl rand -hex 32`. Unset or shorter = endpoint disabled (404).
BACKUP_TOKEN=
